{
  "variables": [
    {
      "name": "speed",
      "type": "number",
      "minimum": 0,
      "maximum": 200,
      "defaultValue": 0
    }
  ],
  "transformations": [
    {
      "name": "needle_angle",
      "type": "rotate",
      "element": "lc-needle",
      "variable": "speed",
      "origin": { "x": 250, "y": 165 },
      "transition": { "duration": 400, "easing": "easeout" },
      "frames": [
        { "at": "$min", "value": -120 },
        { "at": "$max", "value": 120 }
      ]
    },
    {
      "name": "speed_text",
      "type": "text",
      "element": "lc-speed-text",
      "variable": "speed",
      "bind": true
    },
    {
      "name": "status_text",
      "type": "text",
      "element": "lc-status-text",
      "variable": "speed",
      "frames": [
        { "at": "$min", "value": "IMPULSE" },
        { "at": 100, "value": "WARP" },
        { "at": 170, "value": "RED ALERT" }
      ]
    },
    {
      "name": "lc_frame_top_color",
      "type": "fill-color",
      "element": "lc-frame-top",
      "variable": "speed",
      "transition": { "duration": 400, "easing": "linear" },
      "frames": [
        { "at": "$min", "value": "#cc99cc" },
        { "at": 100, "value": "#ff9900" },
        { "at": "$max", "value": "#cc4444" }
      ]
    },
    {
      "name": "lc_frame_bottom_color",
      "type": "fill-color",
      "element": "lc-frame-bottom",
      "variable": "speed",
      "transition": { "duration": 400, "easing": "linear" },
      "frames": [
        { "at": "$min", "value": "#cc99cc" },
        { "at": 100, "value": "#ff9900" },
        { "at": "$max", "value": "#cc4444" }
      ]
    },
    {
